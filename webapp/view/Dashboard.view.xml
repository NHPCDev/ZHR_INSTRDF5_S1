<mvc:View
    controllerName="com.nhpc.zhrinstrdf5s1.controller.Dashboard"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:f="sap.f"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:rowmodes="sap.ui.table.rowmodes"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1"
    class="sapUiSizeCompact"
>
    <f:DynamicPage
        id="_IDGenDynamicPage1"
        headerExpanded="true"
        showFooter="true"
    >
        <f:header>
            <f:DynamicPageHeader id="_IDGenDynamicPageHeader1">
                <f:content>
                    <fb:FilterBar
                        id="filterbar"
                        persistencyKey="myPersKey"
                        useToolbar="false"
                        search=".onSearchBtn"
                    >
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem3"
                                name="ApplicationID"
                                label="{i18n>applicationNo}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="applicationID"
                                        value="{viewModel>/filterData/ApplicationNo}"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem1"
                                name="EmployeeNumber"
                                label="{i18n>empNo}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <Input
                                        id="EmployeeNumber"
                                        value="{viewModel>/filterData/Pernr}"
                                        showValueHelp="true"
                                        app:valuehelp="EmployeeNumber"
                                        valueHelpRequest="onValueHelpRequest"
                                        change="onValueHelpChange"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                        <fb:filterGroupItems>
                            <fb:FilterGroupItem
                                id="_IDGenFilterGroupItem2"
                                name="CreatedOn"
                                label="{i18n>createdOn}"
                                groupName="Group1"
                                visibleInFilterBar="true"
                            >
                                <fb:control>
                                    <DatePicker
                                        id="idCreatedOn"
                                        value="{viewModel>/filterData/CreatedOn}"
                                        displayFormat="dd.MM.yyyy"
                                        valueFormat="yyyyMMdd"
                                        change="onDateChange"
                                    />
                                </fb:control>
                            </fb:FilterGroupItem>
                        </fb:filterGroupItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox id="_IDGenVBox1">
                <table:Table
                    id="idDashboardTable"
                    rows="{
                        path: '/PreClearSet',
                        filters: {
                                path: 'ApprovalFlag',
                                operator: 'EQ',
                                value1: '5'
                            }
                    }"
                    selectionMode="Single"
                    threshold="20"
                    rowSelectionChange="onListItemPress"
                    width="100%"
                    fixedColumnCount="2"
                    class="sapUiSmallMarginTop"
                    alternateRowColors="true"
                    selectionBehavior="RowOnly"
                    showNoData="true"
                >
                    <table:rowMode>
                        <rowmodes:Fixed
                            rowCount="5"
                            rowContentHeight="50%"
                        />
                    </table:rowMode>
                    <table:extension>
                        <OverflowToolbar>
                            <Title
                                id="dashBoardTitle"
                                text="{= ${i18n>dashboardTableTitle} + ' (' + (${viewModel>/dashboardCount} || 0) + ')' }"
                            />
                            <ToolbarSpacer />
                            <Button
                                icon="sap-icon://excel-attachment"
                                text="{i18n>downloadReport}"
                                press="onDownload"
                                type="Reject"
                            />
                        </OverflowToolbar>
                    </table:extension>
                    <table:columns>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>applicationNo}"
                                wrapping="true"
                            />
                            <table:template>
                                <ObjectIdentifier title="{ApplicationNo}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>empNo}"
                                wrapping="true"
                            />
                            <table:template>
                                <ObjectIdentifier
                                    title="{Pernr}"
                                    text="{EmployeeName}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>designation}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{Designation}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>dateAndTimeOfPreClearanceApplication}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text
                                    text="{path:'ConfirmedOn' , formatter:'.formatter.formatDate'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>natureOfTransaction}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text
                                    text="{path:'NatureOfNewTransaction', formatter:'.formatter.formatNatureOfTransaction'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>estimatedNumberOfSecurities}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text
                                    text="{path:'EstimatedNoOfSecurities',formatter:'.formatter.formatNumbers'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>estimatedConsiderationValue}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text
                                    text="{path:'EstimatedConsiderationValue',formatter:'.formatter.formatAmountToINR'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>nameOfTheImmediateRelative}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{ImmediateRelativeName}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>dateOfCommunication}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{path:'Compclearancedate',formatter:'.formatter.formatDate'}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>reasonsForNonClearance}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text text="{ReasonsNonClearance}" />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>createdOn}"
                                wrapping="true"
                            />
                            <table:template>
                                <Text
                                    text="{path:'CreatedOn', formatter:'.formatter.formatDate'}"
                                />
                            </table:template>
                        </table:Column>
                        <table:Column
                            width="200px"
                            hAlign="Center"
                        >
                            <Label
                                text="{i18n>status}"
                                wrapping="true"
                            />
                            <table:template>
                                <ObjectStatus
                                    text="{StatusText}"
                                    class="sapMObjectStatusMedium statusBoldText"
                                    state="{path:'Status',formatter:'.formatter.formatStatusState'}"
                                />
                            </table:template>
                        </table:Column>
                    </table:columns>
                </table:Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
