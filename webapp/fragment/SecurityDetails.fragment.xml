<core:FragmentDefinition
    xmlns = "sap.m"
    xmlns:core="sap.ui.core"
    class="sapUiSizeCompact"
>
    <VBox >
        <Toolbar >
            <Title text="{i18n>securityDetails} ({viewModel>/tableLength})"></Title>
            <ToolbarSpacer />
        </Toolbar>
        <Table items="{viewModel>/tableData}" updateFinished="onTableUpdateFinished" mode="None">
            <columns>
                <Column >
                    <Text text="{i18n>dateOfTransaction}"></Text>
                </Column>
                <Column >
                    <Text text="{i18n>noOfSecuritiesActuallyTraded}"></Text>
                </Column>
                <Column >
                    <Text text="{i18n>price}"></Text>
                </Column>
            </columns>
            <items>
                <ColumnListItem >
                    <cells>
                        <Text text="{path:'viewModel>TransactionDate', formatter:'.formatter.formatDate'}"></Text>
                        <Text text="{viewModel>NoOfSecurities}"></Text>
                        <Text text="{path:'viewModel>Price', formatter:'.formatter.formatAmountToINR'}"></Text>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>
</core:FragmentDefinition>